# Copy this file to .env.local and fill in your values. .env.local is git-ignored; never commit real keys.

# --- AI assistant (Google Gemini). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: use a different Gemini model (default: gemini-flash-lite-latest)
# GEMINI_MODEL=

# --- Login + saved bookings (Supabase). Find both in Supabase: Project Settings -> API.
# These two are PUBLIC values by design. NEVER put the "service_role" key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
